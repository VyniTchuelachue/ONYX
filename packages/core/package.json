{
  "name": "@onyx/core",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic ONYX domain: types, validation, i18n, offline triage and backend adapters (Supabase + demo). Shared by the web app and the future React Native app.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend/index.ts",
    "./supabase": "./src/backend/supabase/index.ts",
    "./demo": "./src/backend/demo/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "zod": "4.6.7"
  }
}
