# ─────────────────────────────────────────────────────────────────────────────
# ONYX web — copy to .env.local and fill in.
# With no Supabase values the app runs in DEMO MODE: fictional data stored in
# the browser, so you can click through every screen without any setup.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Dashboard → Project Settings → API). The publishable/anon key is safe
# to expose: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Force demo mode even when Supabase is configured (e.g. for a sales demo).
NEXT_PUBLIC_DEMO_MODE=false

# Public address of the site, used for link previews (WhatsApp, Facebook). Optional on
# Vercel, which uses the deployment address; set it once you have your own domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI assistant (server-side only — never prefix with NEXT_PUBLIC_).
# Without a key the assistant uses the built-in offline safety guide.
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5. For much lower cost per message, use claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — lower is faster and cheaper.
ANTHROPIC_EFFORT=low

# Phone alerts (Web Push) — optional; see README "Phone alerts". Generate the key pair
# once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Shared with the database (Vault secret onyx_push_hook_secret), at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_HOOK_SECRET=
# Supabase secret key (Dashboard → Project Settings → API Keys; formerly "service_role").
# Server-only: it lets the alert sender look up who to notify. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Map tiles (optional). Defaults to OpenStreetMap's tiles (free, no key), shown dark
# with a CSS filter. OSM's tile policy doesn't allow heavy app traffic, so before launch
# use a keyed provider, e.g. MapTiler (free tier):
#   NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
#   NEXT_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
#   NEXT_PUBLIC_MAP_DARKEN=false   (the tiles are already dark)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_DARKEN=true
